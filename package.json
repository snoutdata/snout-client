{
	"name": "@snoutdata/client",
	"version": "0.1.0",
	"description": "The JavaScript client for SnoutData Cloud: the data API, auth, storage, realtime and Snout Functions of one project, from one URL and one key. No dependencies.",
	"license": "MIT",
	"author": "SnoutData",
	"homepage": "https://docs.snoutdata.com/cloud/api",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"!dist/**/*.test.*",
		"!dist/testing.*",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"snoutdata",
		"postgres",
		"postgrest",
		"realtime",
		"auth",
		"storage"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "^5.7.0"
	}
}
